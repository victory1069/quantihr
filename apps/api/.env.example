# Quanti HR — API configuration
#
# Copy to .env and fill in. Every value here has a working default for local
# development except the ones marked REQUIRED IN PRODUCTION, and the app refuses
# to start in production if those are still on their development settings.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# REQUIRED IN PRODUCTION. Absent → PGlite in memory, which is a development
# driver only. RLS is the tenant isolation mechanism and needs real Postgres.
# DATABASE_URL=postgres://quanti_app:...@localhost:5432/quanti

# REQUIRED IN PRODUCTION. 32+ characters. Rotating this signs everyone out.
# JWT_SECRET=

APP_URL=http://localhost:8081
CORS_ORIGINS=*

MAGIC_LINK_TTL_MINUTES=15
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=90

# ---------------------------------------------------------------------------
# Storage — documents, payslips, transcripts, meeting audio
# ---------------------------------------------------------------------------

# local → files under .storage/  |  s3 → presigned URLs
STORAGE_DRIVER=local
# S3_BUCKET=
# S3_REGION=

# ---------------------------------------------------------------------------
# Email — REQUIRED IN PRODUCTION
#
# The magic link is the sign-in mechanism, so this is not optional: booting
# production with EMAIL_DRIVER=console gives you an app nobody can log into,
# and env.ts refuses to start rather than let that happen quietly.
# ---------------------------------------------------------------------------

# console → log it  |  ses → AWS SES  |  smtp → Resend, Postmark, Mailgun, …
EMAIL_DRIVER=console

# Must be a verified identity on the provider or everything bounces.
EMAIL_FROM=Quanti HR <no-reply@yourdomain.com>

# --- SES ---
# Cheapest at $0.10 per 1,000. New accounts start in the sandbox and can only
# mail verified addresses until you ask support to lift it — do that early.
AWS_REGION=eu-west-1
# AWS_ACCESS_KEY_ID=            # or an instance role, which is better
# AWS_SECRET_ACCESS_KEY=
# Routes bounces and complaints to SNS. Without it a hard bounce is invisible
# and you keep mailing a dead address until SES throttles the whole account.
# SES_CONFIGURATION_SET=quanti-transactional

# --- SMTP (anything else) ---
# Resend: smtp.resend.com : 587, user "resend", password = the API key.
# Useful for launching today while the SES sandbox request is pending.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ---------------------------------------------------------------------------
# SMS — phone verification on sign-up
# ---------------------------------------------------------------------------

# console → log it  |  termii → Nigerian A2P  |  twilio → everywhere else
SMS_DRIVER=console

# --- Termii ---
# TERMII_API_KEY=
TERMII_API_BASE=https://api.ng.termii.com
# Must be an approved sender ID. Approval takes a day or two — start it early.
TERMII_SENDER_ID=Quanti
# LEAVE THIS ON dnd. Most Nigerian numbers are on the do-not-disturb register,
# and the `generic` channel is accepted, billed, and never delivered for those.
TERMII_CHANNEL=dnd

# --- Twilio ---
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+1...

# ---------------------------------------------------------------------------
# Push
# ---------------------------------------------------------------------------

# console → log it  |  expo → POST to Expo Push (free, no account needed)
PUSH_DRIVER=console

# ---------------------------------------------------------------------------
# Meeting assistant
# ---------------------------------------------------------------------------

# Absent → summarisation is skipped and says so, rather than inventing one.
# ANTHROPIC_API_KEY=

# claude-sonnet-5 is roughly 40% the cost of claude-opus-5 for what is an
# extraction task. Start here; the per-meeting cost is recorded in
# meeting_summaries.cost_usd so you can judge the trade on real numbers.
MEETING_MODEL=claude-sonnet-5

# fake → fixtures, no Google project needed  |  google → live Meet + Calendar
GOOGLE_MEET_DRIVER=fake
# GOOGLE_ACCESS_TOKEN=

# none → in-person audio is stored but not transcribed.
# Google Meet transcription is free — Google produces it, we read it — so this
# only bills for in-person capture.
TRANSCRIPTION_DRIVER=none
# DEEPGRAM_API_KEY=
# ASSEMBLYAI_API_KEY=

# Meet deletes structured transcript entries 30 days after the conference.
MEET_TRANSCRIPT_WINDOW_DAYS=30
MEET_TRANSCRIPT_ALERT_DAYS=25
